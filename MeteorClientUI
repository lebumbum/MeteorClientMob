	}, head)
	round(swatch, 4)
	stroke(swatch)

	local picker = create("Frame", {
		BackgroundColor3 = theme.Module, Size = UDim2.new(1, 0, 0, sz(108, 144)), Visible = false, LayoutOrder = 2,
	}, wrapper)
	round(picker, 4)

	local sv = create("Frame", { Position = UDim2.fromOffset(8, 8), Size = UDim2.new(1, -sz(42, 58), 0, sz(92, 128)), ClipsDescendants = true }, picker)
	local white = create("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), Size = UDim2.fromScale(1, 1) }, sv)
	create("UIGradient", { Transparency = NumberSequence.new(0, 1) }, white)
	local black = create("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), Size = UDim2.fromScale(1, 1) }, sv)
	create("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0) }, black)
	local svCursor = create("Frame", {
		BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(8, 8),
	}, sv)
	round(svCursor, 4)
	create("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 1.5 }, svCursor)

	local hue = create("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1), Position = UDim2.new(1, -sz(26, 42), 0, 8), Size = UDim2.fromOffset(sz(16, 30), sz(92, 128)),
	}, picker)
	local keys = {}
	for i = 0, 6 do
		table.insert(keys, ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(math.min(i / 6, 0.9999), 1, 1)))
	end
	create("UIGradient", { Rotation = 90, Color = ColorSequence.new(keys) }, hue)
	local hueCursor = create("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1), AnchorPoint = Vector2.new(0, 0.5), Size = UDim2.new(1, 4, 0, 3),
	}, hue)
	create("UIStroke", { Color = Color3.new(0, 0, 0) }, hueCursor)

	local function update(silent)
		local color = Color3.fromHSV(h, s, v)
		el.CurrentValue = color
		swatch.BackgroundColor3 = color
		sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		svCursor.Position = UDim2.fromScale(s, 1 - v)
		hueCursor.Position = UDim2.new(0, -2, h, 0)
		if not silent then emit(window, opts.Callback, color) end
	end
	update(true)

	function el:Set(color, silent)
		h, s, v = color:ToHSV()
		update(silent)
	end

	bindDrag(sv, nil, function(input)
		s = math.clamp((input.Position.X - sv.AbsolutePosition.X) / math.max(sv.AbsoluteSize.X, 1), 0, 1)
		v = 1 - math.clamp((input.Position.Y - sv.AbsolutePosition.Y) / math.max(sv.AbsoluteSize.Y, 1), 0, 1)
		update()
	end, nil, true)
	bindDrag(hue, nil, function(input)
		h = math.clamp((input.Position.Y - hue.AbsolutePosition.Y) / math.max(hue.AbsoluteSize.Y, 1), 0, 0.9999)
		update()
	end, nil, true)

	head.MouseButton1Click:Connect(function() picker.Visible = not picker.Visible end)
	return self:_finish(el, opts, wrapper)
end

function Elements:CreateEntryList(opts)
	opts = opts or {}
	local wrapper = create("Frame", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = nextOrder(self),
