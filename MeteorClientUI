local function makePanel(window, parent, o)
	local theme = Library.Theme
	local name, width = o.Name, o.Width
	local sidePad = o.SidePad or 0
	local topPad, botPad = o.TopPad or 0, o.BotPad or 0
	local hh = sz(34, 42)

	local panel = create("Frame", {
		Name = name, BackgroundColor3 = o.AccentBg and theme.Accent or theme.Background,
		BackgroundTransparency = o.AccentBg and 0.05 or 0.03,
		Position = o.Position, Size = UDim2.fromOffset(width, hh), ClipsDescendants = true, Active = Library.Mobile,
	}, parent)
	round(panel, 6)
	stroke(panel)
	if o.AccentBg then
		bindAccent(function(c) panel.BackgroundColor3 = c end, panel)
	end

	local header = create("TextButton", {
		BackgroundColor3 = theme.Background, BackgroundTransparency = o.AccentBg and 0 or 1,
		Size = UDim2.new(1, 0, 0, hh),
	}, panel)
	create("TextLabel", {
		Text = name, Font = Library.BoldFont, TextSize = 14, Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(1, -40, 1, 0), TextXAlignment = Enum.TextXAlignment.Left,
	}, header)
	local sign = create("TextLabel", {
		Text = "-", TextColor3 = theme.TextDim, TextSize = 16, AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 0), Size = UDim2.fromOffset(12, hh),
	}, header)
	local line = create("Frame", { Position = UDim2.new(0, 0, 1, -2), Size = UDim2.new(1, 0, 0, 2) }, header)
	create("UIGradient", {
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 0.8) }),
	}, line)
	bindAccent(function(c) line.BackgroundColor3 = c end, line)

	local body = create("ScrollingFrame", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(0, hh), Size = UDim2.new(1, 0, 0, 0),
		ScrollBarThickness = sz(2, 4), Active = Library.Mobile, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
	}, panel)
	if o.AccentBg then
		body.ScrollBarImageColor3 = Color3.new(1, 1, 1)
	else
		bindAccent(function(c) body.ScrollBarImageColor3 = c end, body)
	end
	pad(body, sidePad, sidePad, topPad, botPad)
	local layout = create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, o.Gap or 0) }, body)

	local p = { Panel = panel, Body = body, Collapsed = false }

	local function resize()
		local pw = width
		if Library.Mobile then
			pw = math.min(width, math.max(window:_viewport().X - 24, 200))
		end
		if p.Collapsed then
			panel.Size = UDim2.fromOffset(pw, hh)
			return
		end
		local limit = o.MaxHeight or window.MaxPanelHeight
		if Library.Mobile then
			limit = math.max(math.min(limit, window:_viewport().Y - panel.Position.Y.Offset - hh - 12), 80)
		end
		local h = math.min(layout.AbsoluteContentSize.Y + topPad + botPad, limit)
		body.Size = UDim2.new(1, 0, 0, h)
		panel.Size = UDim2.fromOffset(pw, hh + h)
	end
	p.Resize = resize
	table.insert(window._panels, p)
	layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(resize)
	if Library.Mobile then resize() end

	function p.SetCollapsed(c)
		p.Collapsed = c and true or false
		body.Visible = not p.Collapsed
		sign.Text = p.Collapsed and "+" or "-"
		resize()
	end

	local function toggleCollapsed()
		p.SetCollapsed(not p.Collapsed)
		window:_queueSave()
	end
	header.MouseButton2Click:Connect(toggleCollapsed)

	local function toFront()
		window._z += 1
		panel.ZIndex = window._z
	end
	panel.InputBegan:Connect(function(i) if pointerDown(i) then toFront() end end)

	if o.Draggable then
		local dragStart, startPos, moved
		bindDrag(header, function(input)
			dragStart, startPos, moved = input.Position, panel.Position, false
			toFront()
		end, function(input)
			if not dragStart then return end
			local d = input.Position - dragStart
			if not moved and d.Magnitude > 4 then moved = true end
			if moved then
				panel.Position = UDim2.fromOffset(startPos.X.Offset + d.X, startPos.Y.Offset + d.Y)
			end
		end, function()
			if dragStart then
				if moved then
					window:_queueSave()
				else
					toggleCollapsed()
				end
			end
			dragStart = nil
		end)
	else
		header.MouseButton1Click:Connect(toggleCollapsed)
	end
	return p
end

function Category:CreateModule(opts)
	if type(opts) == "string" then opts = { Name = opts } end
	opts = opts or {}
	local window = self._window
	local theme = Library.Theme
	local flag = opts.Flag or ("mod:" .. self.Name .. ":" .. tostring(opts.Name))

	local mod = setmetatable({
		Type = "Module", Name = opts.Name or "Module", Flag = flag, CurrentValue = false,
		_order = 0, _window = window, _flagBase = flag,
	}, Module)

	local wrapper = create("Frame", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = nextOrder(self),
	}, self._container)
	create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2) }, wrapper)

	local head = create("TextButton", {
		BackgroundColor3 = theme.Module, BackgroundTransparency = 0.55, Size = UDim2.new(1, 0, 0, sz(30, 42)), LayoutOrder = 1,
	}, wrapper)
	round(head, 4)
	local bar = create("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1), Position = UDim2.fromOffset(0, 6), Size = UDim2.new(0, 3, 1, -12), Visible = false,
	}, head)
	round(bar, 2)
	local title = create("TextLabel", {
		Text = mod.Name, Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -sz(44, 54), 1, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
	}, head)

	local dotsBtn = create("TextButton", {
		BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.fromOffset(sz(30, 46), sz(30, 42)),
	}, head)
	local dots = {}
	for i = -1, 1 do
		local d = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, i * 5), Size = UDim2.fromOffset(3, 3),
		}, dotsBtn)
		round(d, 2)
		table.insert(dots, d)
	end

	local settings = create("Frame", {
		BackgroundColor3 = theme.Setting, BackgroundTransparency = 0.2, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y, Visible = false, LayoutOrder = 2,
	}, wrapper)
	round(settings, 4)
	create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4) }, settings)
	pad(settings, 12, 10, 6, 8)
	mod._container = settings

	local hovering = false
	local function render(animate)
		local on = mod.CurrentValue
		local color, transparency
		if on then
			color = Library.Theme.Accent:Lerp(Color3.new(1, 1, 1), 0.35)
			transparency = 0.25
		else
			color = Library.Theme.Module
			transparency = 0.55
		end
		if hovering then transparency = math.max(transparency - 0.12, 0) end
		bar.Visible = on
		title.TextColor3 = on and Library.Theme.Text or Library.Theme.TextDim
		if animate then
			tween(head, { BackgroundColor3 = color, BackgroundTransparency = transparency })
		else
			head.BackgroundColor3 = color
			head.BackgroundTransparency = transparency
		end
		local dotColor = settings.Visible and Color3.new(1, 1, 1) or Library.Theme.TextDim
		for _, d in ipairs(dots) do d.BackgroundColor3 = dotColor end
		if mod._pin and mod._pin.Refresh then mod._pin:Refresh() end
	end
	bindAccent(function() render(false) end, wrapper)

	local function setOpen(open)
		settings.Visible = open
		render(false)
	end

	function mod:Set(v, silent)
		v = v and true or false
		if v == self.CurrentValue then return end
		self.CurrentValue = v
		render(true)
		window:_hudSet(self, v)
		if not silent then
			emit(window, opts.Callback, v)
			if window.ToggleNotify and not window._loading then
				window:Notify({ Title = self.Name, Content = v and "Enabled" or "Disabled", Duration = 1.5 })
			end
		end
	end
	function mod:Toggle() self:Set(not self.CurrentValue) end
	function mod:IsEnabled() return self.CurrentValue end
	function mod:Expand(open) setOpen(open ~= false) end
	function mod:Destroy()
		if Library.Flags[flag] == self then Library.Flags[flag] = nil end
		window:_hudSet(self, false)
		wrapper:Destroy()
	end

	head.MouseButton1Click:Connect(function() mod:Toggle() end)
	head.MouseButton2Click:Connect(function() setOpen(not settings.Visible) end)
	dotsBtn.MouseButton1Click:Connect(function() setOpen(not settings.Visible) end)
	if not Library.Mobile then
		head.MouseEnter:Connect(function()
			hovering = true
			render(true)
			if opts.Description then window:_showTip(opts.Description) end
		end)
		head.MouseLeave:Connect(function()
			hovering = false
			render(true)
			window:_hideTip()
		end)
		head.MouseMoved:Connect(function() window:_moveTip() end)
	end

	Library.Flags[flag] = mod
	if Library.Mobile and opts.Description then
		mod:CreateLabel(opts.Description)
	end
	mod._pin = mod:CreateKeybind({
		Name = "Bind", CurrentKeybind = opts.Keybind, PinLabel = mod.Name,
		GetState = function() return mod.CurrentValue end,
		Callback = function() mod:Toggle() end,
	})
	render(false)

	if opts.CurrentValue == true or opts.Enabled == true then
		mod.CurrentValue = true
		render(false)
		window:_hudSet(mod, true)
		safeCall(opts.Callback, true)
	end
	return mod
end

function Category:SetCollapsed(c) self._p.SetCollapsed(c) end

function Category:IsCollapsed() return self._p.Collapsed end

function Library:CreateWindow(opts)
	opts = opts or {}
	initInput()
	if opts.Mobile ~= nil then
		Library.Mobile = opts.Mobile == true
	else
		Library.Mobile = UIS.TouchEnabled and not UIS.KeyboardEnabled
	end
	Library.TextSize = Library.Mobile and 15 or 13
	local cs = opts.ConfigurationSaving or {}
	local theme = Library.Theme

	local window = setmetatable({
		Name = opts.Name or "Meteor",
		ToggleKey = opts.ToggleKey or Enum.KeyCode.RightShift,
		PanelWidth = opts.PanelWidth or 230,
		MaxPanelHeight = opts.MaxPanelHeight or 460,
		Categories = {},
		_pages = {},
		_pageCount = 0,
		_hud = {},
		_panels = {},
		_pins = {},
		_pinCount = 0,
		Mobile = Library.Mobile,
		_z = 1,
		_saveQueued = false,
		_loading = false,
		Visible = true,
		ToggleNotify = false,
