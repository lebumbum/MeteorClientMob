local function connect(signal, fn)
	local c = signal:Connect(fn)
	table.insert(Library._conns, c)
	return c
end

local function safeCall(cb, ...)
	if type(cb) ~= "function" then return end
	local args = table.pack(...)
	task.spawn(function()
		local ok, err = pcall(cb, table.unpack(args, 1, args.n))
		if not ok then warn("[MeteorUI] callback error: " .. tostring(err)) end
	end)
end

local function tween(inst, props, t)
	TweenService:Create(inst, TweenInfo.new(t or 0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

local function create(class, props, parent)
	local inst = Instance.new(class)
	if inst:IsA("GuiObject") then inst.BorderSizePixel = 0 end
	if inst:IsA("GuiButton") then inst.AutoButtonColor = false end
	if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
		inst.Font = Library.Font
		inst.TextSize = Library.TextSize
		inst.TextColor3 = Library.Theme.Text
		inst.Text = ""
		if inst:IsA("TextLabel") then inst.BackgroundTransparency = 1 end
	end
	for k, v in pairs(props or {}) do inst[k] = v end
	inst.Parent = parent
	return inst
end

local function round(inst, r)
	return create("UICorner", { CornerRadius = UDim.new(0, r or 4) }, inst)
end

local function stroke(inst, color)
	return create("UIStroke", { Color = color or Library.Theme.Outline, Thickness = 1 }, inst)
end

local function pad(inst, l, r, t, b)
	return create("UIPadding", {
		PaddingLeft = UDim.new(0, l or 0), PaddingRight = UDim.new(0, r or 0),
		PaddingTop = UDim.new(0, t or 0), PaddingBottom = UDim.new(0, b or 0),
	}, inst)
end

local function sz(desktop, mobile)
	if Library.Mobile then return mobile end
	return desktop
end

local function bindAccent(fn, inst)
	fn(Library.Theme.Accent)
	Library._accent[fn] = true
	if inst then
		inst.Destroying:Connect(function() Library._accent[fn] = nil end)
	end
	return fn
end

function Library:_applyAccent(color)
	self.Theme.Accent = color
	for fn in pairs(self._accent) do pcall(fn, color) end
end

function Library:SetAccent(color)
	self.BaseAccent = color
	if not self.Rainbow then self:_applyAccent(color) end
end

function Library:SetRainbow(on)
	self.Rainbow = on and true or false
	if not self.Rainbow then
		self:_applyAccent(self.BaseAccent)
	elseif not self._rainbowConn then
		local last = 0
		self._rainbowConn = connect(RunService.Heartbeat, function()
			if not Library.Rainbow then return end
			local now = os.clock()
			if now - last < 0.05 then return end
			last = now
			Library:_applyAccent(Color3.fromHSV((now * 0.1) % 1, 0.65, 1))
		end)
	end
end

local function pointerDown(i)
	return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch
end

local function pointerMove(i)
	return i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch
end

local function bindDrag(handle, onStart, onMove, onEnd, lockScroll)
	local dragging = false
	local active = nil
	local scroller = nil

	local function unlock()
		if scroller then
			scroller.ScrollingEnabled = true
			scroller = nil
		end
	end

	handle.InputBegan:Connect(function(input)
		if pointerDown(input) and not dragging then
			dragging = true
			active = input
			if lockScroll then
				scroller = handle:FindFirstAncestorWhichIsA("ScrollingFrame")
				if scroller then scroller.ScrollingEnabled = false end
			end
			if onStart then onStart(input) end
			if onMove then onMove(input) end
		end
	end)
	connect(UIS.InputChanged, function(input)
		if not dragging or not onMove then return end
		if input.UserInputType == Enum.UserInputType.Touch then
			if input == active then onMove(input) end
		elseif input.UserInputType == Enum.UserInputType.MouseMovement then
			if active and active.UserInputType ~= Enum.UserInputType.Touch then onMove(input) end
		end
	end)
	connect(UIS.InputEnded, function(input)
		if dragging and pointerDown(input) then
			if input.UserInputType == Enum.UserInputType.Touch and input ~= active then return end
			dragging = false
			active = nil
			unlock()
			if onEnd then onEnd(input) end
		end
	end)
end

local function tapDrag(btn, o)
	local startPos, startCenter, moved
	bindDrag(btn, function(input)
		startPos = input.Position
		startCenter = btn.AbsolutePosition + btn.AbsoluteSize / 2
		moved = false
		if o.onDown then o.onDown() end
	end, function(input)
		if not startPos then return end
		local d = input.Position - startPos
		if not moved and d.Magnitude > 8 and (not o.canDrag or o.canDrag()) then
			moved = true
		end
		if moved then
			local gs = btn.Parent.AbsoluteSize
			local c = startCenter + Vector2.new(d.X, d.Y)
			local sx = math.clamp(c.X / math.max(gs.X, 1), 0.03, 0.97)
			local sy = math.clamp(c.Y / math.max(gs.Y, 1), 0.05, 0.95)
			btn.Position = UDim2.fromScale(sx, sy)
			if o.onMoved then o.onMoved(sx, sy) end
		end
	end, function()
		if not startPos then return end
		startPos = nil
		if moved and o.onDragEnd then o.onDragEnd() end
		if o.onUp then o.onUp(moved) end
	end)
end

local function createGui(name)
	local parent
	if type(gethui) == "function" then pcall(function() parent = gethui() end) end
	if not parent then
		local ok = pcall(function() local _ = CoreGui.Name end)
		if ok then parent = CoreGui end
	end
	parent = parent or LocalPlayer:WaitForChild("PlayerGui")

	for _, child in ipairs(parent:GetChildren()) do
		if child.Name == name and child:IsA("ScreenGui") then child:Destroy() end
	end

	local gui = Instance.new("ScreenGui")
	gui.Name = name
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = 1000
	gui.IgnoreGuiInset = true
	if syn and syn.protect_gui then pcall(syn.protect_gui, gui) end

	local ok = pcall(function() gui.Parent = parent end)
	if not ok or not gui.Parent then gui.Parent = LocalPlayer:WaitForChild("PlayerGui") end
	return gui
end

local function fsOK()
	return type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function"
		and type(isfolder) == "function" and type(makefolder) == "function"
end

local function ensureFolder(path)
	local cur = ""
	for part in string.gmatch(path, "[^/]+") do
		cur = (cur == "") and part or (cur .. "/" .. part)
		if not isfolder(cur) then makefolder(cur) end
	end
end

local function sanitize(name)
	return (tostring(name or ""):gsub("[^%w _%-]", ""))
end

local function encodeValue(el)
	local v = el.CurrentValue
	if el.Type == "ColorPicker" then
		return { R = math.floor(v.R * 255 + 0.5), G = math.floor(v.G * 255 + 0.5), B = math.floor(v.B * 255 + 0.5) }
	end
	return v
end

local function decodeValue(el, v)
	if el.Type == "ColorPicker" and type(v) == "table" then
		return Color3.fromRGB(v.R or 255, v.G or 255, v.B or 255)
	end
	return v
end

local function nextOrder(obj)
	obj._order = (obj._order or 0) + 1
	return obj._order
end

local function initInput()
	if Library._inputInit then return end
	Library._inputInit = true

	connect(UIS.InputBegan, function(input, gp)
		if Library._capture then
			if input.UserInputType == Enum.UserInputType.Keyboard then
				local cb = Library._capture
				Library._capture, Library._captureCancel = nil, nil
				cb(input.KeyCode)
			end
			return
		end
		if gp or input.UserInputType ~= Enum.UserInputType.Keyboard then return end
		for _, w in ipairs(Library._windows) do
			if w.ToggleKey and input.KeyCode == w.ToggleKey then w:Toggle() end
		end
		for kb in pairs(Library._keybinds) do
			if kb.CurrentValue == input.KeyCode.Name then
				if kb.HoldToInteract then
					kb.Holding = true
					safeCall(kb.Callback, true)
				else
					safeCall(kb.Callback)
				end
			end
		end
	end)

	connect(UIS.InputEnded, function(input)
		if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
		for kb in pairs(Library._keybinds) do
			if kb.HoldToInteract and kb.Holding and kb.CurrentValue == input.KeyCode.Name then
				kb.Holding = false
				safeCall(kb.Callback, false)
			end
		end
	end)
end

local Elements = {}
Elements.__index = Elements

local Module = setmetatable({}, { __index = Elements })
Module.__index = Module

local Page = setmetatable({}, { __index = Elements })
Page.__index = Page

local Category = {}
Category.__index = Category

local Window = {}
Window.__index = Window

local function emit(window, callback, ...)
	safeCall(callback, ...)
	if window then window:_queueSave() end
end

function Elements:_row(height, class)
	return create(class or "Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, height),
		LayoutOrder = nextOrder(self),
	}, self._container)
end

function Elements:_finish(el, opts, inst)
	el.Name = opts.Name
	el.Instance = inst
	if el.CurrentValue ~= nil then
		el.Flag = opts.Flag or (self._flagBase and opts.Name and (self._flagBase .. ":" .. opts.Name)) or nil
		if el.Flag then Library.Flags[el.Flag] = el end
	end
	function el:Destroy()
		if self.Flag and Library.Flags[self.Flag] == self then Library.Flags[self.Flag] = nil end
		Library._keybinds[self] = nil
		inst:Destroy()
	end
	return el
end

local function rowLabel(row, text, widthScale)
	return create("TextLabel", {
		Text = text, Size = UDim2.new(widthScale or 1, 0, 1, 0), TextXAlignment = Enum.TextXAlignment.Left,
	}, row)
end

function Elements:CreateLabel(opts)
	if type(opts) == "string" then opts = { Text = opts } end
	opts = opts or {}
	local row = self:_row(0)
	row.AutomaticSize = Enum.AutomaticSize.Y
	pad(row, 0, 0, 2, 2)
	local lbl = create("TextLabel", {
		Text = opts.Text or "", TextColor3 = Library.Theme.TextDim, TextSize = sz(12, 14), TextWrapped = true,
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
	}, row)
	local el = { Type = "Label" }
	function el:Set(text) lbl.Text = tostring(text) end
	return self:_finish(el, opts, row)
end

function Elements:CreateSection(opts)
	if type(opts) == "string" then opts = { Name = opts } end
	opts = opts or {}
	local row = self:_row(22)
	local lbl = create("TextLabel", {
		Text = string.upper(opts.Name or "Section"), Font = Library.BoldFont, TextSize = sz(11, 12),
		Size = UDim2.new(1, 0, 1, -2), TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Bottom,
	}, row)
	bindAccent(function(c) lbl.TextColor3 = c end, lbl)
	create("Frame", { BackgroundColor3 = Library.Theme.Outline, Position = UDim2.new(0, 0, 1, -1), Size = UDim2.new(1, 0, 0, 1) }, row)
	local el = { Type = "Section" }
	function el:Set(text) lbl.Text = string.upper(tostring(text)) end
	return self:_finish(el, opts, row)
end

function Elements:CreateButton(opts)
	opts = opts or {}
	local theme = Library.Theme
	local row = self:_row(sz(30, 40))
	local btn = create("TextButton", {
		Text = opts.Name or "Button", BackgroundColor3 = theme.Module,
		Position = UDim2.fromOffset(0, 2), Size = UDim2.new(1, 0, 1, -4),
	}, row)
	round(btn, 4)
	local st = stroke(btn)
	if not Library.Mobile then
		btn.MouseEnter:Connect(function() st.Color = Library.Theme.Accent end)
		btn.MouseLeave:Connect(function() st.Color = Library.Theme.Outline end)
	end
	btn.MouseButton1Click:Connect(function()
		btn.BackgroundColor3 = Library.Theme.Accent
		tween(btn, { BackgroundColor3 = Library.Theme.Module }, 0.3)
		safeCall(opts.Callback)
	end)
	local el = { Type = "Button" }
	function el:Set(text) btn.Text = tostring(text) end
	return self:_finish(el, opts, row)
end

function Elements:CreateToggle(opts)
	opts = opts or {}
	local window = self._window
	local el = { Type = "Toggle", CurrentValue = opts.CurrentValue == true }
	local row = self:_row(sz(26, 38), "TextButton")
	rowLabel(row, opts.Name or "Toggle", 0.8)
	local trackW, trackH, knobS = sz(30, 40), sz(15, 22), sz(11, 16)
	local track = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(trackW, trackH),
	}, row)
	round(track, trackH)
	local knob = create("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1), AnchorPoint = Vector2.new(0, 0.5), Size = UDim2.fromOffset(knobS, knobS),
	}, track)
	round(knob, knobS)
	local knobGap = (trackH - knobS) / 2

	local function render(animate)
		local on = el.CurrentValue
		local color = on and Library.Theme.Accent or Library.Theme.Outline
		local pos = UDim2.new(0, on and (trackW - knobS - knobGap) or knobGap, 0.5, 0)
		if animate then
			tween(track, { BackgroundColor3 = color })
			tween(knob, { Position = pos })
		else
			track.BackgroundColor3 = color
			knob.Position = pos
		end
	end
	bindAccent(function() render(false) end, row)

	function el:Set(v, silent)
		self.CurrentValue = v and true or false
		render(true)
		if not silent then emit(window, opts.Callback, self.CurrentValue) end
	end
	row.MouseButton1Click:Connect(function() el:Set(not el.CurrentValue) end)
	return self:_finish(el, opts, row)
end

function Elements:CreateSlider(opts)
	opts = opts or {}
	local window = self._window
	local min = (opts.Range and opts.Range[1]) or 0
	local max = (opts.Range and opts.Range[2]) or 100
	local inc = (opts.Increment and opts.Increment > 0) and opts.Increment or 1
	local suffix = opts.Suffix and (" " .. opts.Suffix) or ""

	local function snap(v)
		v = math.floor((v - min) / inc + 0.5) * inc + min
		return tonumber(string.format("%.4f", math.clamp(v, min, max)))
	end

	local el = { Type = "Slider", CurrentValue = snap(opts.CurrentValue or min), Range = { min, max } }
	local labelH, trackY, trackH, knobS = sz(22, 26), sz(26, 36), sz(4, 6), sz(10, 20)
	local row = self:_row(sz(36, 52))
	create("TextLabel", {
		Text = opts.Name or "Slider", Size = UDim2.new(0.6, 0, 0, labelH), TextXAlignment = Enum.TextXAlignment.Left,
	}, row)
	local valueLabel = create("TextLabel", {
		AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0.4, 0, 0, labelH),
		TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = Library.Theme.TextDim,
	}, row)
	local track = create("Frame", {
		BackgroundColor3 = Library.Theme.Outline, Position = UDim2.fromOffset(0, trackY), Size = UDim2.new(1, 0, 0, trackH),
	}, row)
	round(track, trackH)
	local fill = create("Frame", { Size = UDim2.fromScale(0, 1) }, track)
	round(fill, trackH)
	local knob = create("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1), AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(knobS, knobS),
	}, track)
	round(knob, knobS)
	bindAccent(function(c) fill.BackgroundColor3 = c end, row)

	local function render()
		local a = (max == min) and 0 or (el.CurrentValue - min) / (max - min)
		fill.Size = UDim2.fromScale(a, 1)
		knob.Position = UDim2.new(a, 0, 0.5, 0)
		valueLabel.Text = tostring(el.CurrentValue) .. suffix
	end
	render()

	function el:Set(v, silent)
		self.CurrentValue = snap(tonumber(v) or min)
		render()
		if not silent then emit(window, opts.Callback, self.CurrentValue) end
	end

	bindDrag(row, nil, function(input)
		local a = math.clamp((input.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		local v = snap(min + (max - min) * a)
		if v ~= el.CurrentValue then el:Set(v) end
	end, nil, true)
	return self:_finish(el, opts, row)
end

function Elements:CreateInput(opts)
	opts = opts or {}
	local window = self._window
	local el = { Type = "Input", CurrentValue = opts.CurrentValue or "" }
	local row = self:_row(sz(28, 40))
	rowLabel(row, opts.Name or "Input", 0.35)
	local box = create("TextBox", {
		BackgroundColor3 = Library.Theme.Module, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.new(0.63, 0, 0, sz(22, 32)), PlaceholderText = opts.PlaceholderText or "...",
		PlaceholderColor3 = Library.Theme.TextDim, Text = el.CurrentValue, ClearTextOnFocus = false,
		TextXAlignment = Enum.TextXAlignment.Left, ClipsDescendants = true,
	}, row)
	round(box, 4)
	pad(box, 7, 7)
	local st = stroke(box)
	box.Focused:Connect(function() st.Color = Library.Theme.Accent end)
	function el:Set(text, silent)
		self.CurrentValue = tostring(text)
		box.Text = self.CurrentValue
		if not silent then emit(window, opts.Callback, self.CurrentValue) end
	end
	box.FocusLost:Connect(function()
		st.Color = Library.Theme.Outline
		el:Set(box.Text)
		if opts.RemoveTextAfterFocusLost then box.Text = "" end
	end)
	return self:_finish(el, opts, row)
end

function Elements:_createPin(el, opts)
	local window = self._window
	if not opts.Callback then
		function el:Set() end
		function el:Destroy() end
		return el
	end

	local label = tostring(opts.PinLabel or opts.Name or "Key")
	local hold = el.HoldToInteract
	local btn = nil

	window._pinCount += 1
	local slot = window._pinCount - 1
	local posEl = {
		Type = "PinPosition",
		CurrentValue = { X = 0.93 - math.floor(slot / 4) * 0.1, Y = 0.3 + (slot % 4) * 0.15 },
	}

	local function applyPos()
		if btn then
			btn.Position = UDim2.fromScale(posEl.CurrentValue.X, posEl.CurrentValue.Y)
		end
	end

	function posEl:Set(v)
		if type(v) == "table" and tonumber(v.X) and tonumber(v.Y) then
			self.CurrentValue = {
				X = math.clamp(tonumber(v.X), 0.03, 0.97),
				Y = math.clamp(tonumber(v.Y), 0.05, 0.95),
			}
			applyPos()
		end
	end

	local function refresh()
		if not btn then return end
		local on = opts.GetState and opts.GetState() or false
		btn.BackgroundColor3 = on and Library.Theme.Accent or Library.Theme.Background
		btn.BackgroundTransparency = on and 0.1 or 0.25
	end

	local function flash()
		if not btn or opts.GetState then return end
		btn.BackgroundColor3 = Library.Theme.Accent
		btn.BackgroundTransparency = 0.1
		tween(btn, { BackgroundColor3 = Library.Theme.Background, BackgroundTransparency = 0.25 }, 0.25)
	end

	local function ensure()
		if btn then return end
		btn = create("TextButton", {
			Text = label, TextScaled = true, Font = Library.BoldFont,
			AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(64, 64),
			BackgroundColor3 = Library.Theme.Background, BackgroundTransparency = 0.25,
			ZIndex = window.Visible and 0 or 60, Active = true,
		}, window.Gui)
		round(btn, 32)
		pad(btn, 8, 8, 8, 8)
		create("UITextSizeConstraint", { MaxTextSize = 14, MinTextSize = 8 }, btn)
		local st = stroke(btn, Library.Theme.Accent)
		st.Thickness = 2
		bindAccent(function(c)
			st.Color = c
			refresh()
		end, btn)
		window._pins[btn] = true
		btn.Destroying:Connect(function() window._pins[btn] = nil end)
		applyPos()
		tapDrag(btn, {
			canDrag = function() return window.Visible end,
			onMoved = function(x, y) posEl.CurrentValue = { X = x, Y = y } end,
			onDragEnd = function() window:_queueSave() end,
			onDown = function()
				if hold and not window.Visible then
					el.Holding = true
					safeCall(el.Callback, true)
				end
			end,
			onUp = function(moved)
				if hold then
					if el.Holding then
						el.Holding = false
						safeCall(el.Callback, false)
					end
					return
				end
				if moved then return end
				flash()
				safeCall(el.Callback)
			end,
		})
	end

	local toggle = self:CreateToggle({
		Name = "On-screen " .. label,
		CurrentValue = false,
		Callback = function(v)
			if v then
				ensure()
				btn.Visible = true
				refresh()
			elseif btn then
				btn.Visible = false
			end
		end,
	})

	local base = toggle.Flag or ("pin:" .. label)
	Library.Flags[base .. ":pos"] = posEl
	self:_finish(el, opts, toggle.Instance)
	local baseDestroy = el.Destroy

	function el:Refresh() refresh() end
	function el:Set(k)
		if typeof(k) == "EnumItem" then
			self.CurrentValue = k.Name
		elseif type(k) == "string" and k ~= "" then
			self.CurrentValue = k
		else
			self.CurrentValue = "None"
		end
	end
	function el:Destroy()
		if btn then btn:Destroy() end
		Library.Flags[base .. ":pos"] = nil
		toggle:Destroy()
		baseDestroy(self)
	end

	Library._keybinds[el] = true
	return el
end

function Elements:CreateKeybind(opts)
	opts = opts or {}
	local window = self._window
	local function toName(k)
		if typeof(k) == "EnumItem" then return k.Name end
		if type(k) == "string" and k ~= "" then return k end
		return "None"
	end
	local el = {
		Type = "Keybind",
		CurrentValue = toName(opts.CurrentKeybind or opts.CurrentValue),
		HoldToInteract = opts.HoldToInteract == true,
		Holding = false,
		Callback = opts.Callback,
	}
	if Library.Mobile then
		return self:_createPin(el, opts)
	end
	local row = self:_row(26)
	rowLabel(row, opts.Name or "Keybind", 0.5)
	local btn = create("TextButton", {
		BackgroundColor3 = Library.Theme.Module, AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(86, 20), TextSize = 11,
	}, row)
	round(btn, 4)
	local st = stroke(btn)
	local listening = false
	local function render()
		btn.Text = listening and "..." or string.upper(el.CurrentValue)
		btn.TextColor3 = listening and Library.Theme.Accent or Library.Theme.Text
		st.Color = listening and Library.Theme.Accent or Library.Theme.Outline
	end
	render()

	function el:Set(k, silent)
		self.CurrentValue = toName(k)
		render()
		if window then window:_queueSave() end
		if not silent and opts.OnBind then safeCall(opts.OnBind, self.CurrentValue) end
	end

	btn.MouseButton1Click:Connect(function()
		if Library._captureCancel then Library._captureCancel() end
		listening = true
		render()
		Library._captureCancel = function() listening = false; render() end
		Library._capture = function(keyCode)
			listening = false
			if keyCode == Enum.KeyCode.Backspace then
				el:Set("None")
			elseif keyCode ~= Enum.KeyCode.Escape then
				el:Set(keyCode.Name)
			end
			render()
		end
	end)

	Library._keybinds[el] = true
	return self:_finish(el, opts, row)
end

function Elements:CreateDropdown(opts)
	opts = opts or {}
	local window = self._window
	local theme = Library.Theme
	local multi = opts.MultipleOptions == true
	local el = { Type = "Dropdown", Options = opts.Options or {}, CurrentValue = {} }

	local initial = opts.CurrentOption or opts.CurrentValue
	if type(initial) == "string" then el.CurrentValue = { initial }
	elseif type(initial) == "table" then el.CurrentValue = { table.unpack(initial) } end
	if not multi and #el.CurrentValue > 1 then el.CurrentValue = { el.CurrentValue[1] } end

	local wrapper = create("Frame", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = nextOrder(self),
	}, self._container)
	create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2) }, wrapper)

	local headH = sz(26, 38)
	local head = create("TextButton", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, headH), LayoutOrder = 1 }, wrapper)
	rowLabel(head, opts.Name or "Dropdown", 0.4)
	local valueLabel = create("TextLabel", {
		AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 0), Size = UDim2.new(0.6, -16, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Right, TextTruncate = Enum.TextTruncate.AtEnd,
	}, head)
	local arrow = create("TextLabel", {
		Text = "+", TextColor3 = theme.TextDim, TextSize = 14,
		AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.fromOffset(12, headH),
	}, head)

	local list = create("Frame", {
		BackgroundColor3 = theme.Module, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y, Visible = false, LayoutOrder = 2,
	}, wrapper)
	round(list, 4)
	create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, list)
	pad(list, 0, 0, 3, 3)

	local buttons = {}
	local function render()
		valueLabel.Text = (#el.CurrentValue > 0) and table.concat(el.CurrentValue, ", ") or "None"
		valueLabel.TextColor3 = Library.Theme.Accent
		for name, b in pairs(buttons) do
			b.TextColor3 = table.find(el.CurrentValue, name) and Library.Theme.Accent or Library.Theme.TextDim
		end
	end
	local function setOpen(open)
		list.Visible = open
		arrow.Text = open and "-" or "+"
	end

	local function build()
		for _, b in pairs(buttons) do b:Destroy() end
		buttons = {}
		for i, option in ipairs(el.Options) do
			local name = tostring(option)
			local b = create("TextButton", {
				Text = name, Size = UDim2.new(1, 0, 0, sz(22, 34)), LayoutOrder = i,
				BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left,
			}, list)
			pad(b, 10)
			buttons[name] = b
			b.MouseButton1Click:Connect(function()
				local nv
				if multi then
					nv = { table.unpack(el.CurrentValue) }
					local idx = table.find(nv, name)
					if idx then table.remove(nv, idx) else table.insert(nv, name) end
				else
					nv = { name }
					setOpen(false)
				end
				el:Set(nv)
			end)
		end
	end
	build()
	bindAccent(function() render() end, wrapper)

	function el:Set(v, silent)
		local nv = {}
		if type(v) == "string" then nv = { v } elseif type(v) == "table" then nv = { table.unpack(v) } end
		if not multi and #nv > 1 then nv = { nv[1] } end
		self.CurrentValue = nv
		render()
		if not silent then emit(window, opts.Callback, self.CurrentValue) end
	end

	function el:Refresh(options)
		self.Options = options or {}
		local keep = {}
		for _, name in ipairs(self.CurrentValue) do
			if table.find(self.Options, name) then table.insert(keep, name) end
		end
		self.CurrentValue = keep
		build()
		render()
	end

	head.MouseButton1Click:Connect(function() setOpen(not list.Visible) end)
	return self:_finish(el, opts, wrapper)
end

function Elements:CreateColorPicker(opts)
