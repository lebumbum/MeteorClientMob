	return window
end

function Window:SetVisible(v)
	self.Visible = v and true or false
	self.Holder.Visible = self.Visible
	if self.Fab then self.Fab.Visible = not self.Visible end
	if self.CloseBtn then self.CloseBtn.Visible = self.Visible end
	for pin in pairs(self._pins) do
		pin.ZIndex = self.Visible and 0 or 60
	end
	if not self.Visible then self:_hideTip() end
end

function Window:_viewport()
	local s = self.Gui.AbsoluteSize
	if s.X > 0 and s.Y > 0 then return s end
	local cam = workspace.CurrentCamera
	return cam and cam.ViewportSize or Vector2.new(1280, 720)
end

function Window:Toggle() self:SetVisible(not self.Visible) end

function Window:SetHudVisible(v) self.Hud.Visible = v and true or false end

function Window:SetDim(v)
	self._dim = v and true or false
	self.Backdrop.Visible = self._dim
end

function Window:_showTip(text)
	self.TipLabel.Text = text
	self.Tip.Visible = true
	self:_moveTip()
end

function Window:_hideTip() self.Tip.Visible = false end

function Window:_moveTip()
	if not self.Tip.Visible then return end
	local m = UIS:GetMouseLocation()
	self.Tip.Position = UDim2.fromOffset(m.X + 14, m.Y + 16)
end

function Window:_hudSet(mod, on)
	local label = self._hud[mod]
	if on and not label then
		local w = TextService:GetTextSize(mod.Name, sz(13, 14), Library.Font, Vector2.new(500, 30)).X
		label = create("TextLabel", {
			Text = mod.Name, BackgroundTransparency = 0.45, BackgroundColor3 = Color3.new(0, 0, 0),
			Size = UDim2.new(), AutomaticSize = Enum.AutomaticSize.XY, LayoutOrder = -math.floor(w), TextSize = sz(13, 14), ZIndex = 5,
		}, self.Hud)
		pad(label, 7, 7, 2, 2)
		bindAccent(function(c) label.TextColor3 = c end, label)
		self._hud[mod] = label
	elseif not on and label then
		label:Destroy()
		self._hud[mod] = nil
	end
end

function Window:Notify(opts)
	opts = opts or {}
	local theme = Library.Theme
	local duration = opts.Duration or 4
	local toast = create("CanvasGroup", {
		BackgroundColor3 = theme.Background, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y, GroupTransparency = 1,
	}, self.NotifHolder)
	round(toast, 6)
	stroke(toast)
	local timer = create("Frame", { BackgroundColor3 = theme.Accent, Size = UDim2.new(1, 0, 0, 2) }, toast)
	local inner = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, toast)
	pad(inner, 12, 10, 9, 8)
	create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2) }, inner)
	create("TextLabel", {
		Text = opts.Title or "Notification", Font = Library.BoldFont, Size = UDim2.new(1, 0, 0, 16),
		TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 1,
	}, inner)
	if opts.Content and opts.Content ~= "" then
		create("TextLabel", {
			Text = opts.Content, TextColor3 = theme.TextDim, TextWrapped = true, TextSize = 12,
			Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
			TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = 2,
		}, inner)
	end
	tween(toast, { GroupTransparency = 0 }, 0.2)
	TweenService:Create(timer, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 0, 2) }):Play()
	task.delay(duration, function()
		if toast.Parent then
			tween(toast, { GroupTransparency = 1 }, 0.25)
			task.wait(0.3)
			toast:Destroy()
		end
	end)
end

function Library:Notify(opts)
	local w = self._windows[1]
	if w then w:Notify(opts) end
end

function Window:_addPage(name, screen, available, order)
	self._pageCount += 1
	local width = TextService:GetTextSize(name, Library.TextSize, Library.Font, Vector2.new(500, 30)).X + 28
	local btn = create("TextButton", {
		Text = name, Size = UDim2.fromOffset(width, sz(38, 40)), BackgroundTransparency = 1,
		TextColor3 = Library.Theme.TextDim, Visible = available, LayoutOrder = order or self._pageCount,
	}, self.Nav)
	local underline = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -3), Size = UDim2.new(1, -20, 0, 2), Visible = false,
	}, btn)
	round(underline, 1)
	bindAccent(function(c) underline.BackgroundColor3 = c end, underline)
	btn.MouseButton1Click:Connect(function()
		self._navigated = true
		self:SelectPage(name)
	end)
	self._pages[name] = {
		Screen = screen, Button = btn, Underline = underline, Available = available, Order = order or self._pageCount,
	}
end

function Window:SelectPage(name)
	local target = self._pages[name]
	if not target or not target.Available then
		name = self._defaultPage
		target = name and self._pages[name]
		if not target then
			for n, p in pairs(self._pages) do
				if p.Available and (not target or p.Order < target.Order) then
					name, target = n, p
				end
			end
		end
		if not target then return end
	end
	self.CurrentPage = name
	for n, p in pairs(self._pages) do
		local on = (n == name)
		p.Screen.Visible = on
		p.Underline.Visible = on
		tween(p.Button, { TextColor3 = on and Library.Theme.Text or Library.Theme.TextDim })
	end
end

function Window:_createMobileCategory(name)
	local screen = create("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false }, self.Holder)
	local p = makePanel(self, screen, {
		Name = name, Position = UDim2.new(0.5, 0, 0, 54), Width = 340, Draggable = false, AccentBg = true,
		SidePad = 6, TopPad = 6, BotPad = 6, Gap = 4, MaxHeight = 480,
	})
	p.Panel.AnchorPoint = Vector2.new(0.5, 0)
	self:_addPage(name, screen, true, -500 + #self.Categories)
	local cat = setmetatable({ Name = name, _window = self, _container = p.Body, _order = 0, Panel = p.Panel, _p = p }, Category)
	table.insert(self.Categories, cat)
	if #self.Categories == 1 and not self._navigated then
		self:SelectPage(name)
	end
	return cat
end

function Window:CreateCategory(name)
	name = tostring(name or "Category")
	if Library.Mobile then
		return self:_createMobileCategory(name)
	end
	local idx = #self.Categories
	local cam = workspace.CurrentCamera
	local vx = cam and cam.ViewportSize.X or 1280
	local width, gap = self.PanelWidth, 14
	local perRow = math.max(1, math.floor((vx - 32) / (width + gap)))
	local x = 20 + (idx % perRow) * (width + gap)
	local y = 66 + math.floor(idx / perRow) * 44

	local p = makePanel(self, self._modulesScreen, {
		Name = name, Position = UDim2.fromOffset(x, y), Width = width, Draggable = true, AccentBg = true,
		SidePad = 4, TopPad = 4, BotPad = 4, Gap = 3,
	})
	local cat = setmetatable({ Name = name, _window = self, _container = p.Body, _order = 0, Panel = p.Panel, _p = p }, Category)
	table.insert(self.Categories, cat)
	return cat
end

function Window:CreatePage(name, opts)
	opts = opts or {}
	name = tostring(name or "Page")
	local available = true
	if opts.Game ~= nil then
		local ids = type(opts.Game) == "table" and opts.Game or { opts.Game }
		available = table.find(ids, game.PlaceId) ~= nil or table.find(ids, game.GameId) ~= nil
	end
	local screen = create("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false }, self.Holder)
	local p = makePanel(self, screen, {
		Name = name, Position = UDim2.new(0.5, 0, 0, sz(66, 54)), Width = opts.Width or 340, Draggable = false,
		SidePad = 10, TopPad = 8, BotPad = 8, Gap = 4, MaxHeight = opts.MaxHeight or 480,
	})
	p.Panel.AnchorPoint = Vector2.new(0.5, 0)
	self:_addPage(name, screen, available)
	return setmetatable({ Name = name, _window = self, _container = p.Body, _order = 0, Available = available }, Page)
end

function Window:CreateListPage(opts)
	opts = opts or {}
	local name = opts.Name or "List"
	local window = self
	local page = self:CreatePage(name, { Game = opts.Game })
	local flag = opts.Flag or ("list:" .. name)
	local names = {}
	local wl, sv

	local function indexOf(v)
		local k = string.lower(typeof(v) == "Instance" and v.Name or tostring(v))
		for i, n in ipairs(names) do
			if string.lower(n) == k then return i end
		end
	end

	local function resolve(text)
		text = tostring(text or ""):match("^%s*(.-)%s*$")
		if text == "" then return nil end
		local low = text:lower()
		for _, p in ipairs(Players:GetPlayers()) do
			if p.Name:lower() == low or p.DisplayName:lower() == low then return p.Name end
		end
		for _, p in ipairs(Players:GetPlayers()) do
			if p.Name:lower():sub(1, #low) == low then return p.Name end
		end
		return text
	end

	local el = { Type = "List", Name = name, Flag = flag, CurrentValue = names }
	Library.Flags[flag] = el
	Library.Lists[name] = page

	local function refresh()
		local whitelist = {}
		for _, n in ipairs(names) do
			table.insert(whitelist, { Text = n, Actions = { { Text = "Remove", Callback = function() page:Remove(n) end } } })
		end
		wl:Render(whitelist)

		local server = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer then
				local has = indexOf(p) ~= nil
				local text = (p.DisplayName == p.Name) and p.Name or (p.DisplayName .. "  @" .. p.Name)
				table.insert(server, { Text = text, Actions = { {
					Text = has and "Remove" or "Add",
					Callback = function() if has then page:Remove(p.Name) else page:Add(p.Name) end end,
				} } })
			end
		end
		sv:Render(server)
	end

	local function commit()
		el.CurrentValue = names
		refresh()
		emit(window, opts.OnChange, names)
	end

	function el:Set(v)
		names = {}
		for _, n in ipairs(type(v) == "table" and v or {}) do table.insert(names, tostring(n)) end
		self.CurrentValue = names
		refresh()
		safeCall(opts.OnChange, names)
	end

	function page:Add(text)
		local n = resolve(text)
		if not n or indexOf(n) then return false end
		table.insert(names, n)
		commit()
		return true
	end
	function page:Remove(text)
		local i = indexOf(text)
		if not i then return false end
		table.remove(names, i)
		commit()
		return true
	end
	function page:Has(v) return indexOf(v) ~= nil end
	function page:Get() return { table.unpack(names) } end
	function page:Clear()
		names = {}
		commit()
	end

	page:CreateLabel(opts.Description or "Players in this list. Saved per game with your config.")
	page:CreateInput({
		Name = "Add", PlaceholderText = sz("username, press Enter", "username, then tap Done"), RemoveTextAfterFocusLost = true,
		Callback = function(t) if t ~= "" then page:Add(t) end end,
	})
	page:CreateSection(name)
	wl = page:CreateEntryList({ Empty = "Nobody added yet" })
	page:CreateSection("Server players")
	sv = page:CreateEntryList({ Empty = "No other players in this server" })
	page:CreateButton({ Name = "Clear list", Callback = function() page:Clear() end })

	connect(Players.PlayerAdded, function() task.defer(refresh) end)
	connect(Players.PlayerRemoving, function() task.delay(0.1, refresh) end)
	refresh()
	return page
end

function Window:_dir()
	local d = self.Config.FolderName
	if self.Config.PerGame then d = d .. "/" .. tostring(game.PlaceId) end
	return d
end

function Window:_path(name)
	return self:_dir() .. "/" .. sanitize(name or self.CurrentConfig) .. ".json"
end

function Window:SaveConfiguration(name)
	if not fsOK() then return false, "Executor has no file system functions" end
	name = sanitize(name or self.CurrentConfig)
	if name == "" then return false, "Invalid config name" end
	local ok, err = pcall(function()
		local data = {}
		for flag, el in pairs(Library.Flags) do
			if el.CurrentValue ~= nil then data[flag] = encodeValue(el) end
		end
		data.__panels = {}
		for _, cat in ipairs(Library.Mobile and {} or self.Categories) do
			data.__panels[cat.Name] = {
				X = cat.Panel.Position.X.Offset, Y = cat.Panel.Position.Y.Offset, Collapsed = cat._p.Collapsed,
			}
		end
		ensureFolder(self:_dir())
		writefile(self:_path(name), HttpService:JSONEncode(data))
	end)
	if not ok then return false, tostring(err) end
	self.CurrentConfig = name
	return true
end

function Window:LoadConfiguration(name)
	if not fsOK() then return false, "Executor has no file system functions" end
	name = sanitize(name or self.CurrentConfig)
	local path = self:_path(name)
	if not isfile(path) then return false, "Config '" .. name .. "' does not exist" end
	local ok, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
	if not ok or type(data) ~= "table" then return false, "Config file is corrupted" end

	self._loading = true
	for flag, el in pairs(Library.Flags) do
		local raw = data[flag]
		if raw ~= nil then
			local success, e = pcall(function() el:Set(decodeValue(el, raw)) end)
			if not success then warn("[MeteorUI] failed to load '" .. flag .. "': " .. tostring(e)) end
		end
	end
	if type(data.__panels) == "table" and not Library.Mobile then
		for _, cat in ipairs(self.Categories) do
			local info = data.__panels[cat.Name]
			if type(info) == "table" then
				cat.Panel.Position = UDim2.fromOffset(info.X or 20, info.Y or 66)
				cat._p.SetCollapsed(info.Collapsed == true)
			end
		end
	end
	self._loading = false
	self.CurrentConfig = name
	return true
end

function Window:DeleteConfiguration(name)
	if not fsOK() or type(delfile) ~= "function" then return false, "delfile is not supported" end
	local path = self:_path(name)
	if not isfile(path) then return false, "Config does not exist" end
	pcall(delfile, path)
	return true
end

function Window:ListConfigs()
	local names = {}
	if fsOK() and type(listfiles) == "function" and isfolder(self:_dir()) then
		for _, path in ipairs(listfiles(self:_dir())) do
			local n = tostring(path):match("([^/\\]+)%.json$")
			if n then table.insert(names, n) end
		end
	end
	table.sort(names)
	return names
end

function Window:_queueSave()
	if not self.Config.Enabled or self._loading or self._saveQueued then return end
	self._saveQueued = true
	task.delay(0.6, function()
		self._saveQueued = false
		self:SaveConfiguration()
	end)
end

function Library:LoadConfiguration(name)
	local w = self._windows[1]
	if w then return w:LoadConfiguration(name) end
end

function Window:_buildConfigPage()
	local page = self:CreatePage("Config")
	local newName = ""
	local status = page:CreateLabel("")
	local list

	local function refresh()
		status:Set("Game " .. tostring(game.PlaceId) .. "  -  active: " .. self.CurrentConfig)
		local entries = {}
		for _, n in ipairs(self:ListConfigs()) do
			local function report(ok, err, title)
				self:Notify({ Title = ok and title or "Failed", Content = ok and n or tostring(err) })
				refresh()
			end
			table.insert(entries, {
				Text = n .. (n == self.CurrentConfig and "   (active)" or ""),
				Actions = {
					{ Text = "Load", Callback = function() local ok, err = self:LoadConfiguration(n); report(ok, err, "Config loaded") end },
					{ Text = "Save", Callback = function() local ok, err = self:SaveConfiguration(n); report(ok, err, "Config saved") end },
					{ Text = "Delete", Callback = function() local ok, err = self:DeleteConfiguration(n); report(ok, err, "Config deleted") end },
				},
			})
		end
		list:Render(entries)
	end

	page:CreateSection("Create")
	page:CreateInput({ Name = "Name", PlaceholderText = "config name", Callback = function(t) newName = sanitize(t) end })
	page:CreateButton({ Name = "Create config", Callback = function()
		if newName == "" then
			self:Notify({ Title = "Enter a config name first" })
			return
		end
		local ok, err = self:SaveConfiguration(newName)
		self:Notify({ Title = ok and "Config created" or "Failed", Content = ok and newName or tostring(err) })
		refresh()
	end })
	page:CreateSection("Configs")
	list = page:CreateEntryList({ Empty = "No configs saved yet" })
	page:CreateSection("Options")
	page:CreateToggle({ Name = "Auto save", CurrentValue = self.Config.Enabled, Callback = function(v) self.Config.Enabled = v end })
	refresh()
	self.ConfigPage = page
end

function Window:_buildGuiPage()
	local page = self:CreatePage("GUI")
	local window = self
	local accent

	page:CreateSection("Theme")
	page:CreateDropdown({
		Name = "Preset", Options = Library.PresetOrder, CurrentOption = "Meteor",
		Callback = function(o)
			local c = Library.Presets[o[1]]
			if c and accent then accent:Set(c) end
		end,
	})
	accent = page:CreateColorPicker({
		Name = "Accent color", Color = Library.Theme.Accent, Flag = "gui:Accent",
		Callback = function(c) Library:SetAccent(c) end,
	})
	page:CreateToggle({ Name = "Rainbow accent", CurrentValue = false, Flag = "gui:Rainbow", Callback = function(v) Library:SetRainbow(v) end })

	page:CreateSection("Interface")
	page:CreateToggle({ Name = "Show Active Modules", CurrentValue = false, Flag = "gui:ShowActiveModules", Callback = function(v) window:SetHudVisible(v) end })
	page:CreateToggle({ Name = "Toggle notifications", CurrentValue = false, Flag = "gui:ToggleNotify", Callback = function(v) window.ToggleNotify = v end })
	page:CreateToggle({ Name = "Dim background", CurrentValue = window._dim, Flag = "gui:Dim", Callback = function(v) window:SetDim(v) end })
	page:CreateKeybind({
		Name = "Menu key", CurrentKeybind = self.ToggleKey, Flag = "gui:MenuKey",
		OnBind = function(k) window.ToggleKey = (k ~= "None") and Enum.KeyCode[k] or nil end,
	})
	page:CreateButton({ Name = "Unload GUI", Callback = function() Library:Destroy() end })
	self.GuiPage = page
end

function Window:Destroy()
	if self.Gui then self.Gui:Destroy() end
end

function Library:Destroy()
	for _, c in ipairs(self._conns) do pcall(function() c:Disconnect() end) end
	for _, w in ipairs(self._windows) do w:Destroy() end
	self._conns, self._accent, self._windows, self._keybinds = {}, {}, {}, {}
	self.Flags, self.Lists = {}, {}
	self._inputInit, self._rainbowConn, self._capture, self._captureCancel = nil, nil, nil, nil
	self.Rainbow = false
end

return Library
